"""Compara respostas do RAG usando todos os modelos de chat Gemini disponíveis
para a chave configurada.

Uso:
    uv run python scripts/compare_models.py "Sua pergunta aqui"

Se nenhuma pergunta for passada, usa uma pergunta padrão de teste.
"""
from __future__ import annotations

import sys

import chromadb
from google import genai

from vorstellungsgesprach import conf, rag

# Tipos de modelo que não servem para chat/geração de texto e devem ser ignorados
_SKIP_SUBSTRINGS = ["embedding", "imagen", "veo", "tts", "audio", "robotics"]

DEFAULT_QUESTION = "Welche Jobs erfordern Erfahrung mit Machine Learning?"
CHROMA_PATH = "./chroma_db"
COLLECTION_NAME = "vagas_ti"


def list_available_chat_models(client: genai.Client) -> list[str]:
    """Retorna somente os modelos que respondem com sucesso a um prompt simples."""
    available = []
    for model in client.models.list():
        name = model.name
        if any(skip in name for skip in _SKIP_SUBSTRINGS):
            continue
        try:
            client.models.generate_content(model=name, contents="Reply only with OK.")
            available.append(name)
        except Exception:
            continue
    return available


def compare_models(question: str) -> list[dict]:
    """Roda a mesma pergunta em todos os modelos disponíveis e retorna os resultados."""
    client = genai.Client(api_key=conf.GEMINI_API_KEY)

    print("Descobrindo modelos disponíveis...")
    available_models = list_available_chat_models(client)
    print(f"{len(available_models)} modelos disponíveis: {available_models}\n")

    chroma_client = chromadb.PersistentClient(path=CHROMA_PATH)
    collection = chroma_client.get_collection(name=COLLECTION_NAME)

    results = []
    for model_name in available_models:
        try:
            result = rag.answer(collection, question, model=model_name)
            results.append(result)
            print(f"\n{'=' * 60}\nModelo: {model_name}\n{'=' * 60}")
            print(result["answer"])
        except Exception as e:
            print(f"\n❌ {model_name} falhou: {e}")

    return results


if __name__ == "__main__":
    question = sys.argv[1] if len(sys.argv) > 1 else DEFAULT_QUESTION
    compare_models(question)